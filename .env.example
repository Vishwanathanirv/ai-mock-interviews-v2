# Required in production: 32+ random characters used to sign session cookies.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# Optional: Postgres connection string (Neon, Supabase, RDS...).
# Without it the app uses an embedded Postgres (PGlite) stored in ./.data.
DATABASE_URL=

# Optional: enables AI grading, tailored follow-ups and the written debrief.
# Free key: https://aistudio.google.com/apikey   (never commit a real key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
